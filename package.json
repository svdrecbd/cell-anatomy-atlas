{
  "name": "cell-anatomy-atlas",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "corpus:export-edge": "node scripts/export-edge-corpus.mjs",
    "cloudflare:types": "wrangler types --config wrangler.jsonc",
    "d1:migrate:local": "wrangler d1 migrations apply SIGNUPS_DB --local --config wrangler.jsonc",
    "signups:export": "node scripts/export-beta-signups.mjs",
    "arrivals:export": "node scripts/export-dataset-arrivals.mjs",
    "preview": "next start --hostname 127.0.0.1 --port 3100",
    "verify:search-metadata": "node scripts/verify-search-metadata.mjs http://127.0.0.1:3100",
    "verify:corpus-mechanics": "node scripts/verify-corpus-mechanics.mjs",
    "measure:network": "node scripts/measure-page-payloads.mjs http://127.0.0.1:3100 review/network-after.json",
    "verify:network-budget": "npm run measure:network && node scripts/verify-network-budget.mjs",
    "test": "node --experimental-strip-types --test scripts/test-request-security.mjs scripts/test-dataset-arrivals.mjs scripts/test-signup-submission-limits.mjs scripts/test-structured-data.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "typescript": "5.6.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.7",
    "@rolldown/binding-linux-x64-gnu": "^1.2.7",
    "lightningcss-darwin-arm64": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "type": "module",
  "license": "MIT"
}
